diff --git a/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainApi.java b/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainApi.java
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainApi.java
@@ -0,0 +1,70 @@
+package com.aerodynamics4mc.api;
+
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.ConcurrentSkipListMap;
+
+/**
+ * Optional platform-neutral terrain input for the server-authoritative L0/L1 atmosphere.
+ *
+ * <p>Providers should claim only columns whose terrain authority they own. Unclaimed columns
+ * continue through Aerodynamics4MC's normal worldgen terrain provider. Overlapping claims are
+ * rejected rather than resolved by registration order.
+ */
+public final class AeroTerrainApi {
+    private static final ConcurrentSkipListMap<String, Registration> PROVIDERS =
+            new ConcurrentSkipListMap<>();
+
+    private AeroTerrainApi() {
+    }
+
+    /**
+     * Registers one terrain authority under a stable integration identifier.
+     *
+     * @return a handle that removes exactly this registration when closed
+     */
+    public static AutoCloseable registerProvider(A4mcId providerId, AeroTerrainProvider provider) {
+        Objects.requireNonNull(providerId, "providerId");
+        Objects.requireNonNull(provider, "provider");
+        String key = providerId.toString();
+        Registration registration = new Registration(providerId, provider);
+        Registration previous = PROVIDERS.putIfAbsent(key, registration);
+        if (previous != null) {
+            throw new IllegalStateException("terrain provider already registered: " + providerId);
+        }
+        return () -> PROVIDERS.remove(key, registration);
+    }
+
+    /**
+     * Returns the unique claimed terrain sample, or {@link AeroTerrainSample#UNAVAILABLE}.
+     *
+     * <p>Provider exceptions are intentionally not swallowed. A broken terrain authority must not
+     * silently turn into different weather.
+     */
+    public static AeroTerrainSample sample(A4mcWorldRef world, int blockX, int blockZ) {
+        Objects.requireNonNull(world, "world");
+        AeroTerrainSample claimed = AeroTerrainSample.UNAVAILABLE;
+        A4mcId claimedBy = null;
+        for (Map.Entry<String, Registration> entry : PROVIDERS.entrySet()) {
+            Registration registration = entry.getValue();
+            AeroTerrainSample candidate = Objects.requireNonNull(
+                    registration.provider().sample(world, blockX, blockZ),
+                    () -> "terrain provider returned null: " + registration.providerId());
+            if (!candidate.available()) {
+                continue;
+            }
+            if (claimed.available()) {
+                throw new IllegalStateException(
+                        "multiple terrain providers claimed column "
+                                + blockX + "," + blockZ
+                                + ": " + claimedBy + " and " + registration.providerId());
+            }
+            claimed = candidate;
+            claimedBy = registration.providerId();
+        }
+        return claimed;
+    }
+
+    private record Registration(A4mcId providerId, AeroTerrainProvider provider) {
+    }
+}
diff --git a/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainProvider.java b/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainProvider.java
