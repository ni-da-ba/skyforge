@@ -0,0 +1,7 @@
+package com.aerodynamics4mc.api;
+
+/** Supplies authoritative coarse terrain only for columns owned by an integration. */
+@FunctionalInterface
+public interface AeroTerrainProvider {
+    AeroTerrainSample sample(A4mcWorldRef world, int blockX, int blockZ);
+}
diff --git a/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainSample.java b/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainSample.java
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainSample.java
@@ -0,0 +1,40 @@
+package com.aerodynamics4mc.api;
+
+import java.util.Objects;
+
+/** Platform-neutral terrain forcing consumed by Aerodynamics4MC's coarse atmosphere. */
+public record AeroTerrainSample(
+        boolean available,
+        float terrainHeightBlocks,
+        float biomeTemperature,
+        float roughnessLengthMeters,
+        AeroTerrainSurfaceClass surfaceClass) {
+    public static final AeroTerrainSample UNAVAILABLE =
+            new AeroTerrainSample(false, 0.0f, 0.0f, 0.0f, AeroTerrainSurfaceClass.UNKNOWN);
+
+    public AeroTerrainSample {
+        Objects.requireNonNull(surfaceClass, "surfaceClass");
+        if (available) {
+            if (!Float.isFinite(terrainHeightBlocks)
+                    || !Float.isFinite(biomeTemperature)
+                    || !Float.isFinite(roughnessLengthMeters)) {
+                throw new IllegalArgumentException("available terrain samples must be finite");
+            }
+            if (roughnessLengthMeters < 0.0f) {
+                throw new IllegalArgumentException("roughnessLengthMeters must be non-negative");
+            }
+            if (surfaceClass == AeroTerrainSurfaceClass.UNKNOWN) {
+                throw new IllegalArgumentException("available terrain samples require a surface class");
+            }
+        }
+    }
+
+    public static AeroTerrainSample available(
+            float terrainHeightBlocks,
+            float biomeTemperature,
+            float roughnessLengthMeters,
+            AeroTerrainSurfaceClass surfaceClass) {
+        return new AeroTerrainSample(
+                true, terrainHeightBlocks, biomeTemperature, roughnessLengthMeters, surfaceClass);
+    }
+}
diff --git a/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainSurfaceClass.java b/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainSurfaceClass.java
new file mode 100644
index 0000000..4444444
--- /dev/null
+++ b/api/src/main/java/com/aerodynamics4mc/api/AeroTerrainSurfaceClass.java
@@ -0,0 +1,11 @@
+package com.aerodynamics4mc.api;
+
+/** Stable coarse surface classes used by L0/L1 roughness and thermal forcing. */
+public enum AeroTerrainSurfaceClass {
+    UNKNOWN,
+    WATER,
+    PLAINS,
+    FOREST,
+    ROCK,
+    SNOW
+}
diff --git a/src/main/java/com/aerodynamics4mc/runtime/WorldgenSeedTerrainProvider.java b/src/main/java/com/aerodynamics4mc/runtime/WorldgenSeedTerrainProvider.java
index b2110fe..5555555 100644
--- a/src/main/java/com/aerodynamics4mc/runtime/WorldgenSeedTerrainProvider.java
+++ b/src/main/java/com/aerodynamics4mc/runtime/WorldgenSeedTerrainProvider.java
@@ -1,5 +1,9 @@
 package com.aerodynamics4mc.runtime;
 
+import com.aerodynamics4mc.api.A4mcId;
+import com.aerodynamics4mc.api.A4mcWorldRef;
+import com.aerodynamics4mc.api.AeroTerrainApi;
+import com.aerodynamics4mc.api.AeroTerrainSample;
 import net.minecraft.core.Holder;
 import net.minecraft.server.level.ServerChunkCache;
 import net.minecraft.server.level.ServerLevel;
@@ -17,6 +21,20 @@ final class WorldgenSeedTerrainProvider implements SeedTerrainProvider {
 
     @Override
     public TerrainSample sample(ServerLevel world, int blockX, int blockZ) {
+        var dimensionId = world.dimension().identifier();
+        AeroTerrainSample integrationSample = AeroTerrainApi.sample(
+                A4mcWorldRef.server(
+                        A4mcId.of(dimensionId.getNamespace(), dimensionId.getPath()),
+                        world),
+                blockX,
+                blockZ);
+        if (integrationSample.available()) {
+            return new TerrainSample(
+                    integrationSample.terrainHeightBlocks(),
+                    integrationSample.biomeTemperature(),
+                    integrationSample.roughnessLengthMeters(),
+                    surfaceClass(integrationSample));
+        }
         try {
             ServerChunkCache chunkManager = world.getChunkSource();
             ChunkGenerator generator = chunkManager.getGenerator();
@@ -66,4 +84,16 @@ final class WorldgenSeedTerrainProvider implements SeedTerrainProvider {
             return fallback.sample(world, blockX, blockZ);
         }
     }
+
+    private static byte surfaceClass(AeroTerrainSample sample) {
+        return switch (sample.surfaceClass()) {
+            case WATER -> HashedSeedTerrainProvider.SURFACE_CLASS_WATER;
+            case PLAINS -> HashedSeedTerrainProvider.SURFACE_CLASS_PLAINS;
+            case FOREST -> HashedSeedTerrainProvider.SURFACE_CLASS_FOREST;
+            case ROCK -> HashedSeedTerrainProvider.SURFACE_CLASS_ROCK;
+            case SNOW -> HashedSeedTerrainProvider.SURFACE_CLASS_SNOW;
+            case UNKNOWN -> throw new IllegalArgumentException(
+                    "available terrain integration sample has UNKNOWN surface class");
+        };
+    }
 }
