diff --git a/src/main/java/dev/fallingcloud/windy/WindStateProvider.java b/src/main/java/dev/fallingcloud/windy/WindStateProvider.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/dev/fallingcloud/windy/WindStateProvider.java
@@ -0,0 +1,29 @@
+package dev.fallingcloud.windy;
+
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * Optional presentation-only wind source. Velocity is actual world-space metres/second,
+ * including gust. Providers must return unavailable instead of inventing replacement weather.
+ * Gameplay and weather authority remain outside Windy.
+ */
+@FunctionalInterface
+public interface WindStateProvider {
+    Sample sample(ClientLevel level, Vec3 worldPosition);
+
+    record Sample(Vec3 velocityMetersPerSecond, float gustMetersPerSecond, boolean available) {
+        public static final Sample UNAVAILABLE = new Sample(Vec3.ZERO, 0f, false);
+
+        public Sample {
+            if (velocityMetersPerSecond == null
+                    || !Double.isFinite(velocityMetersPerSecond.x)
+                    || !Double.isFinite(velocityMetersPerSecond.y)
+                    || !Double.isFinite(velocityMetersPerSecond.z)
+                    || !Float.isFinite(gustMetersPerSecond)
+                    || gustMetersPerSecond < 0f) {
+                throw new IllegalArgumentException("Invalid wind sample");
+            }
+        }
+    }
+}
