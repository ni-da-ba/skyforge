 public final class WindDirector {
     public static final WindDirector INSTANCE = new WindDirector();
 
+    // Optional injection seam: Skyforge can provide real wind without creating a competing simulation.
+    private static volatile WindStateProvider externalProvider;
+
+    public static void useExternalWind(WindStateProvider provider) {
+        externalProvider = java.util.Objects.requireNonNull(provider, "provider");
+    }
+
+    public static boolean hasExternalWind() {
+        return externalProvider != null;
+    }
+
+    /** Missing or failed samples are calm/unavailable; never silently generate substitute wind. */
+    public static WindStateProvider.Sample sampleExternal(ClientLevel level, Vec3 position) {
+        WindStateProvider provider = externalProvider;
+        if (provider == null) return WindStateProvider.Sample.UNAVAILABLE;
+        try {
+            WindStateProvider.Sample sample = provider.sample(level, position);
+            return sample == null ? WindStateProvider.Sample.UNAVAILABLE : sample;
+        } catch (RuntimeException ex) {
+            // A provider failure must not resurrect Windy's autonomous generator.
+            return WindStateProvider.Sample.UNAVAILABLE;
+        }
+    }
+
+    /** Exact normalized local airflow direction; this does not synthesize wind. */
+    public static Vec3 externalDirection(ClientLevel level, Vec3 point) {
+        WindStateProvider.Sample sample = sampleExternal(level, point);
+        return sample.available() && sample.velocityMetersPerSecond().lengthSqr() > 1.0e-8
+                ? sample.velocityMetersPerSecond().normalize() : Vec3.ZERO;
+    }
