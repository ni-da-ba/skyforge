diff --git a/src/main/java/dev/fallingcloud/windy/A4mcWindStateProvider.java b/src/main/java/dev/fallingcloud/windy/A4mcWindStateProvider.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/dev/fallingcloud/windy/A4mcWindStateProvider.java
@@ -0,0 +1,44 @@
+package dev.fallingcloud.windy;
+
+import com.aerodynamics4mc.api.A4mcId;
+import com.aerodynamics4mc.api.A4mcVec3;
+import com.aerodynamics4mc.api.A4mcWorldRef;
+import com.aerodynamics4mc.api.AeroWindSample;
+import com.aerodynamics4mc.api.SamplePolicy;
+import com.aerodynamics4mc.api.client.AeroClientWindApi;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * Client presentation adapter for A4MC's replicated physical flow.
+ * This adapter cannot submit wind or change game physics. Local-only L2 is deliberately
+ * excluded, since that visualization could claim lift that server-side gliders do not get.
+ */
+public final class A4mcWindStateProvider implements WindStateProvider {
+    @Override
+    public Sample sample(ClientLevel level, Vec3 point) {
+        if (!AeroClientWindApi.isAvailable()) return Sample.UNAVAILABLE;
+        ResourceLocation dim = level.dimension().location();
+        A4mcWorldRef world = A4mcWorldRef.client(A4mcId.of(dim.getNamespace(), dim.getPath()));
+
+        AeroWindSample physical = AeroClientWindApi.sample(
+                world,
+                A4mcVec3.of(point.x, point.y, point.z),
+                SamplePolicy.SERVER_AGGREGATED_PREFERRED
+        );
+        if (!physical.hasFlow()
+                || physical.authority() == AeroWindSample.Authority.CLIENT_LOCAL
+                || physical.authority() == AeroWindSample.Authority.UNTRUSTED) {
+            return Sample.UNAVAILABLE;
+        }
+        A4mcVec3 velocity = physical.effectiveVelocityVector();
+        A4mcVec3 gust = physical.gustVelocityVector();
+        double gustMagnitude = gust.length();
+        return new Sample(
+                new Vec3(velocity.x(), velocity.y(), velocity.z()),
+                (float) gustMagnitude,
+                true
+        );
+    }
+}
