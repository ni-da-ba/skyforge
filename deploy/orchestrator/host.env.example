# Example only. Do not commit real secrets.
SKYFORGE_ORCHESTRATOR_DEDICATED_CLONE=1
SKYFORGE_REQUIRE_WEBHOOK_SECRET=1
SKYFORGE_STARTUP_RECONCILE=1
SKYFORGE_ORCHESTRATOR_AUTO_MERGE=0
SKYFORGE_TRUSTED_GITHUB_ACTORS=ni-da-ba

# Generate at least 32 high-entropy characters on the host.
SKYFORGE_WEBHOOK_SECRET=<replace-on-host>

# Required for value accounting. Set these from the actual provisioned Droplet.
SKYFORGE_HOST_ACTIVATED_AT=<UTC timestamp written by installer>
SKYFORGE_DROPLET_HOURLY_USD=<actual hourly rate>
SKYFORGE_VALUE_REPORT_ISSUE=378

# First-week hosted ceilings. Raise only after value telemetry justifies it.
SKYFORGE_ORCHESTRATOR_MAX_CLASSIFIER_CALLS_PER_DAY=24
SKYFORGE_ORCHESTRATOR_MAX_WORKER_CALLS_PER_DAY=4
